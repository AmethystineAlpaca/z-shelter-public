{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/shelter/event-vr.schema.json",
  "title": "Shelter Events V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "summary", "tags", "trigger", "choices"],
  "properties": {
    "schema_version": {"const": "event-vr-1"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "trigger": {"$ref": "#/$defs/choiceLogic"},
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/choice"}
    }
  },
  "$defs": {
    "choiceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "choice_id"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "choice_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "choiceLogic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventory_at_least"],
          "properties": {"inventory_at_least": {
            "type": "object",
            "additionalProperties": false,
            "required": ["holder", "item_id", "amount"],
            "properties": {
              "holder": {"type": "string", "minLength": 1},
              "item_id": {"type": "string", "minLength": 1},
              "amount": {"type": "integer", "minimum": 1}
            }
          }}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["always"],
          "properties": {"always": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected"],
          "properties": {"selected": {"$ref": "#/$defs/choiceRef"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/choiceLogic"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/choiceLogic"}
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "action_id"],
          "properties": {"type": {"const": "action.execute"}, "action_id": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resolver_id", "params"],
          "properties": {"type": {"const": "world.resolve"}, "resolver_id": {"type": "string"}, "params": {"type": "object"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "holder", "resource_id", "delta"],
          "properties": {
            "type": {"const": "resource.change"},
            "holder": {"type": "string"},
            "resource_id": {"type": "string"},
            "delta": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "from", "to", "resource_id", "amount"],
          "properties": {
            "type": {"const": "resource.transfer"},
            "from": {"type": "string"},
            "to": {"type": "string"},
            "resource_id": {"type": "string"},
            "amount": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "field", "value"],
          "properties": {
            "type": {"const": "state.set"},
            "target": {"type": "string"},
            "field": {"type": "string"},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "field", "delta"],
          "properties": {
            "type": {"const": "state.change"},
            "target": {"type": "string"},
            "field": {"type": "string"},
            "delta": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "modifier_id", "value"],
          "oneOf": [{"required": ["duration_events"]}, {"required": ["duration_nights"]}],
          "properties": {
            "type": {"const": "modifier.add"},
            "target": {"type": "string"},
            "modifier_id": {"type": "string"},
            "value": {"type": "number"},
            "duration_events": {"type": ["integer", "null"], "minimum": 1}
            ,"duration_nights": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "prerequisite", "effects", "result_text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "prerequisite": {"$ref": "#/$defs/choiceLogic"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "result_text": {"type": "string", "minLength": 1}
      }
    }
  }
}
