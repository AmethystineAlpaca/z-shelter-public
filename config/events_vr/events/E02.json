{
  "schema_version": "event-vr-1",
  "id": "E02",
  "title": "供水中断",
  "summary": "水龙头咳出一阵浑浊的气泡，随后彻底安静了。你沿管线找到一处松脱的接头，旁边地面已经湿了一片。接下来的饮水只能靠备用水撑着。",
  "tags": [
    "shelter",
    "early",
    "negative"
  ],
  "trigger": {
    "always": true
  },
  "choices": [
    {
      "id": "repair_water",
      "label": "用一份金属材料修好水龙头",
      "description": "消耗金属材料 1，修好水龙头并恢复供水。",
      "prerequisite": {
        "always": true
      },
      "effects": [
        {
          "type": "resource.change",
          "holder": "home",
          "resource_id": "metal",
          "delta": -1
        },
        {
          "type": "state.set",
          "target": "home",
          "field": "water",
          "value": true
        },
        {
          "type": "state.set",
          "target": "$source",
          "field": "status",
          "value": "resolved"
        }
      ],
      "result_text": "你用一份金属材料修好水龙头，再慢慢打开阀门。水先咳了两下，随后稳稳流出；接下来饮水不必再动用备用水了。"
    },
    {
      "id": "leave",
      "label": "暂时接受停水",
      "description": "先用备用水维持，每天消耗 1 份。备用水耗尽后，连续三天无法补水就会渴死。（随时可以用一份金属材料修好水龙头。）",
      "prerequisite": {
        "always": true
      },
      "effects": [
        {
          "type": "state.set",
          "target": "home",
          "field": "water",
          "value": false
        },
        {
          "type": "state.set",
          "target": "$source",
          "field": "status",
          "value": "resolved"
        }
      ],
      "result_text": "你关紧阀门，决定先靠备用水撑一撑。每天都得从储备里拿出一份；如果连备用水也没了，还能撑多久？（随时可以用一份金属材料修好水龙头。）"
    }
  ]
}
